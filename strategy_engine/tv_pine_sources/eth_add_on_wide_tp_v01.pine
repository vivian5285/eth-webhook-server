//@version=5
strategy("ETH·加仓最小改动 + 平开独立提前入场锁", overlay=true, initial_capital=1000, default_qty_type=strategy.fixed, default_qty_value=1000, currency=currency.USDT, pyramiding=1)

// ======================== Webhook 固定参数（VPS适配，与生产环境保持一致，未做任何改动） ========================
bot_id = "Trillion_God_v6.5_Pro_Light"
secret = "528586"

// 说明：exit_json已删除，TP1/TP2/TP3不再往外发送协议外的通用CLOSE消息——
// VPS开仓时已用entryPayload里的tp1/tp2/stop_loss/atr字段独立挂好止盈止损雷达，全程不需要TV再通知。
// 【新增】action新增ADD_LONG/ADD_SHORT两种(加仓一次，需useAddOnEntry=true才会出现)：
// 字段结构与LONG/SHORT一致，但不带tp1/tp2/tp3(沿用首次入场时已经挂好的雷达)，
// stop_loss字段固定等于加仓那一刻的activeStop(可能已是保本价)，即"止损绝不因加仓而下调"——
// VPS端需要自行新增对这两个action的处理逻辑(增加仓位、止损只能上移不能下移)，这部分尚未实现，需要单独确认VPS端设计。

// ======================== 控制面板参数 ========================
// ---- 回测时间 ----
startDate = input.time(timestamp("2020-01-01"), "回测开始日期")
endDate   = input.time(timestamp("2030-01-01"), "回测结束日期")
inTimeRange = time >= startDate and time <= endDate

// ---- 入场/出场评分阈值 ----
longEntryScore  = input.int(2, "多头入场分（满分7：只保留4H+日线趋势+RSI+stochK+isVolatile+量能+KDJ，需重新校准）", minval=0, maxval=7, step=1)
shortEntryScore = input.int(2, "空头入场分（满分7）", minval=0, maxval=7, step=1)
quickExitScore  = input.int(2, "快速平仓分数阈值", minval=1, maxval=3, step=1)
quickExitConfirmBars = input.int(2, "反转确认所需连续K线数（防止单根K线噪音触发，1=不要求连续，等于原逻辑）", minval=1, maxval=5)
rsiExitLevel    = input.int(50, "RSI反转平仓阈值", minval=30, maxval=70, step=1)

// ---- 真正的KDJ金叉/死叉，作为快速平仓的额外确认门槛（不是数值越线，是交叉事件；默认关闭） ----
useKDJExitConfirm = input.bool(false, "🔧 反转平仓需KDJ同步确认（K在D下方才平多/K在D上方才平空，更严格）", group="反转确认（评分系统）")
kdjLen = input.int(9, "KDJ RSV长度", group="反转确认（评分系统）")
kdjSmoothK = input.int(3, "K平滑长度", group="反转确认（评分系统）")
kdjSmoothD = input.int(3, "D平滑长度", group="反转确认（评分系统）")

// ---- 裸K+量能快速反转触发 ----
grp_candlevol = "===== 裸K+量能反转（4H级别） ====="
exitModeSelect = input.string("混合(评分OR 4H，任一满足即出)", "反转出场模式", options=["纯评分系统(原版)", "4H裸K+量能主导(完全取代评分)", "混合(评分OR 4H，任一满足即出)"], group=grp_candlevol)
candleBodyRatio = input.float(0.55, "决定性K线实体占比阈值（实体/K线全长，越大要求K线越干净利落）", minval=0.3, maxval=0.95, step=0.05, group=grp_candlevol)
candleVolMultiplier = input.float(1.15, "反转确认所需放量倍数（相对20周期均量）", minval=1.0, step=0.05, group=grp_candlevol)

// ---- 入场裸K确认闸 ----
grp_entryconfirm = "===== 入场裸K确认闸 ====="
useEntryCandleConfirm = input.bool(false, "🔧 入场需裸K确认（触发入场的K线本身也要有方向性决心，过滤十字星/长影线的犹豫入场）", group=grp_entryconfirm)
entryCandleBodyRatio = input.float(0.5, "入场确认所需实体占比阈值（实体/K线全长）", minval=0.2, maxval=0.95, step=0.05, group=grp_entryconfirm)

// ---- 入场独立放量确认（v7.0核心：按评分强度分层生效） ----
grp_entryvol = "===== 入场独立放量确认（评分强度分层） ====="
useEntryVolumeConfirm = input.bool(true, "🔧 入场需独立放量确认（仅在评分刚过门槛的边缘信号生效，评分明显超标的强信号自动豁免）", group=grp_entryvol)
entryVolumeMultiplier = input.float(1.3, "入场放量确认倍数（相对20周期均量，独立于评分池里的1.1倍软阈值）", minval=1.0, step=0.05, group=grp_entryvol)
scoreMarginForSkipVolume = input.int(2, "评分超过入场门槛多少分即视为强信号、豁免放量确认", minval=0, maxval=5, group=grp_entryvol)

// ---- 【新增·温和结合】次级确认票数门槛：isVolatile/量能/KDJ 三项里至少要过几项 ----
grp_quality = "===== 次级确认票数门槛(温和结合原版的质量把关，可调旋钮0~3) ====="
useQualityGate = input.bool(false, "🔧 启用次级确认票数门槛(在v7.0评分系统基础上，额外要求 isVolatile/量能/KDJ 三项里至少过N项；关闭时100%等同v7.0原版)", group=grp_quality)
minQualityVotes = input.int(2, "至少需要同时满足几项(0=不限制=v7.0原版行为，3=三项全过=接近原版6.5的严格度)", minval=0, maxval=3, group=grp_quality)

// ---- 【新增】评分新鲜度信号：本bar评分刚好达标(上一bar未达标)，视为新鲜突破，可豁免放量确认门槛，提升入场敏捷度 ----
grp_fresh = "===== 评分新鲜度信号(新增,默认关闭,提升入场敏捷度) ====="
useFreshSignalBoost = input.bool(false, "🔧 评分刚好达标的新鲜突破豁免放量确认门槛(不必等量能确认，更快入场；只豁免放量门槛，评分门槛本身不放宽；关闭时100%等同原版)", group=grp_fresh)

// ---- 【新增】评分骤降快速出场：单根K线评分环比骤降达到阈值，独立于连续确认要求，立即触发平仓，提升出场敏捷度 ----
grp_crash = "===== 评分骤降快速出场(新增,默认关闭,提升出场敏捷度) ====="
useScoreCrashExit = input.bool(false, "🔧 单根K线评分骤降超过阈值时立即平仓(不必等连续N根确认，专门应对急转弯行情；关闭时100%等同原版)", group=grp_crash)
scoreCrashThreshold = input.int(3, "评分单根骤降阈值(环比下降达到此分数即触发)", minval=1, maxval=6, group=grp_crash)

// ---- 【新增】强趋势加仓一次：仅当首次入场和当前都是强趋势(tier=2)、已有浮盈、评分明显更强时，允许加仓一次 ----
grp_addon = "===== 强趋势加仓一次(新增,默认关闭,需要pyramiding=1配合) ====="
useAddOnEntry = input.bool(false, "🔧 强趋势下允许加仓一次(首次入场tier=2且当前实时tier也=2才生效，每笔持仓生命周期内最多加仓一次；关闭时100%等同原版)", group=grp_addon)
addOnMinProfitATRMult = input.float(1.5, "加仓所需最小浮盈(ATR倍数，浮盈达到此距离才允许加仓)", minval=0.5, maxval=5, step=0.1, group=grp_addon)
addOnScoreMargin = input.int(2, "加仓所需评分超出首次入场门槛的分数(确认趋势没有走弱)", minval=0, maxval=5, group=grp_addon)
addOnMinBarsGap = input.int(3, "距首次入场至少间隔几根K线才允许加仓(防止评分抖动同波触发两次)", minval=1, maxval=20, group=grp_addon)
addOnSizeRatio = input.float(0.5, "加仓仓位占首次仓位的比例(不重新按当前权益计算，直接按首仓比例缩放，避免总风险失控)", minval=0.1, maxval=1.0, step=0.05, group=grp_addon)

// ---- 连续逆势K线快速离场 ----
grp_consec = "===== 连续逆势K线快速离场 ====="
useConsecAdverseExit = input.bool(false, "🔧 启用连续逆势K线快速离场（不看指标，纯粹数K线颜色，比RSI更快）", group=grp_consec)
consecAdverseBars = input.int(3, "连续几根逆势K线后触发离场", minval=2, maxval=6, group=grp_consec)

// ---- 大周期趋势评分（本版只做4H+日线，本地图表周期和12H已从评分中移除） ----
use_4H_trend   = input.bool(true, "使用 4H EMA 趋势")
use_1D_trend   = input.bool(true, "使用 日线 EMA 趋势")

// ---- 过滤开关（KDJ + 量能）——这两个仍然只是评分池里的加分项 ----
use_kdj_filter   = input.bool(true, "启用 KDJ 加分项（K>D 多头加分 / K<D 空头加分）")
use_volume_filter = input.bool(true, "启用量能加分项（量比 > 阈值 加分）")
volume_threshold = input.float(1.1, "量比阈值", step=0.1, minval=1.0)

// ---- 原版核心参数 ----
emaFastLen = input.int(15, "快线 EMA")
emaSlowLen = input.int(30, "慢线 EMA")
adxLen = input.int(14, "ADX 趋势长度")
rsiLen = input.int(14, "RSI 动能长度")
minADX = input.float(17, "最小 ADX 趋势阈值（v7.0起：仅供参考显示，不再参与入场评分/门槛判断）")

// ---- 实盘风控 ----
baseRiskPercent = input.float(1.45, "基础风险占比 %", step=0.1, minval=0.3, maxval=2.0)
maxLeverage = input.float(3.0, "单笔最大允许杠杆倍数", minval=1, maxval=5)

// ---- 仓位规模：默认纯复利(strategy.equity驱动，符合实盘真实风控逻辑)，硬顶仅作为可选的极端情况保险 ----
grp_sizing = "===== 仓位规模(默认纯复利，硬顶为可选保险) ====="
useFixedCapitalBase = input.bool(false, "🔧 改用固定本金基数(不推荐默认开启，仅用于单独测试固定仓位场景；实盘按比例复利是正常风控，不是bug)", group=grp_sizing)
fixedCapitalBase = input.float(1000, "固定本金基数(USDT，仅在上面开关打开时生效)", minval=100, group=grp_sizing)
maxNotionalCap = input.float(200000, "单笔最大名义价值上限(USDT，极端保险，正常复利增长下不应触发)", minval=1000, group=grp_sizing)

// ---- 弱/中/强三档的止损+TP距离系数 ----
grp_tier_th = "===== 档位划分阈值（仅用于止损/TP距离校准，与入场判断无关） ====="
adxWeakThreshold   = input.float(20, "弱/中趋势分界ADX值（低于此值=弱趋势）", group=grp_tier_th)
adxStrongThreshold = input.float(30, "中/强趋势分界ADX值（高于此值=强趋势）", group=grp_tier_th)
globalSLMultiplier = input.float(1.0, "🔧 全局硬止损系数（在三档基础上整体缩放）", minval=0.3, maxval=3.0, step=0.05, group=grp_tier_th)

grp_weak = "===== 弱趋势档位(本版宽止盈，系数大幅拉宽) ====="
weakSLMult  = input.float(1.0, "弱趋势 止损ATR倍数(未改动)", group=grp_weak)
weakTP1Mult = input.float(6.0, "弱趋势 TP1 ATR倍数(原1.0)", group=grp_weak)
weakTP2Mult = input.float(10.0, "弱趋势 TP2 ATR倍数(原1.8)", group=grp_weak)
weakTP3Mult = input.float(16.0, "弱趋势 TP3 ATR倍数(原2.6)", group=grp_weak)

grp_mid = "===== 中等趋势档位(本版宽止盈，系数大幅拉宽) ====="
midSLMult  = input.float(1.3, "中等趋势 止损ATR倍数(未改动)", group=grp_mid)
midTP1Mult = input.float(7.0, "中等趋势 TP1 ATR倍数(原1.35)", group=grp_mid)
midTP2Mult = input.float(12.0, "中等趋势 TP2 ATR倍数(原2.5)", group=grp_mid)
midTP3Mult = input.float(20.0, "中等趋势 TP3 ATR倍数(原3.6)", group=grp_mid)

grp_strong = "===== 强趋势档位(本版宽止盈，系数大幅拉宽) ====="
strongSLMult  = input.float(1.3, "强趋势 止损ATR倍数(未改动)", group=grp_strong)
strongTP1Mult = input.float(9.0, "强趋势 TP1 ATR倍数(原1.8)", group=grp_strong)
strongTP2Mult = input.float(15.0, "强趋势 TP2 ATR倍数(原3.2)", group=grp_strong)
strongTP3Mult = input.float(25.0, "强趋势 TP3 ATR倍数(原5.0)", group=grp_strong)

// ---- 分批止盈占比 ----
tp1Pct = input.int(10, "TP1 占比%")
tp2Pct = input.int(20, "TP2 占比%（TP3自动=100-TP1-TP2）")

// ---- 【修复】保本移动止损：触发距离独立设置，不再绑定被拉宽的TP1距离 ----
grp_be = "===== 保本移动止损(独立于TP距离，不受宽止盈影响) ====="
beTriggerATRMult = input.float(1.5, "浮盈达到多少倍ATR后，止损移动到保本价(原版错误地绑定在TP1距离上，TP1拉宽到6~9倍后这个保护基本失效)", minval=0.5, maxval=5, step=0.1, group=grp_be)

// ---- 极端行情保护 ----
maxDailyLossPercent = input.float(5.5, "单日最大亏损 % 熔断", step=0.5, minval=2, maxval=10)
volThreshold = input.float(0.0028, "波动率过滤门槛", step=0.0002, minval=0.001, maxval=0.005)

// ---- 追踪止盈紧度 ----
trailTight = input.float(0.65, "追踪止盈紧度系数 (越小越紧)", step=0.05, minval=0.3, maxval=1.2)

// ======================== 【新增】盘中提前入场（大阳/大阴不用等收盘） ========================
grp_early = "===== 盘中提前入场（大阳/大阴及时进场） ====="
useEarlyEntry = input.bool(true, "🔓 启用盘中提前入场（配合独立防闪烁锁，安全）", group=grp_early)
earlyBodyThreshold = input.float(0.5, "提前入场实体最小ATR倍数（0.3激进~0.8保守）", minval=0.2, maxval=1.5, step=0.05, group=grp_early)

// ======================== 指标计算（防修正锁定版） ========================
adxCalc(len) =>
    tr = ta.rma(ta.tr(true), len)
    up = high - high[1]
    down = low[1] - low
    plusDI = 100 * ta.rma(up > down and up > 0 ? up : 0, len) / tr
    minusDI = 100 * ta.rma(down > up and down > 0 ? down : 0, len) / tr
    ta.rma(100 * math.abs(plusDI - minusDI) / (plusDI + minusDI + 0.0001), len)

decisionBundle() =>
    ef   = ta.ema(close, emaFastLen)
    es   = ta.ema(close, emaSlowLen)
    r    = ta.rsi(close, rsiLen)
    a    = ta.atr(14)
    sk   = ta.sma(ta.stoch(close, high, low, 14), 3)
    va   = ta.vwma(volume, 20)
    adxv = adxCalc(adxLen)
    kL   = ta.lowest(low, kdjLen)
    kH   = ta.highest(high, kdjLen)
    rsvv = (close - kL) / math.max(kH - kL, syminfo.mintick) * 100
    kK   = ta.sma(rsvv, kdjSmoothK)
    kD   = ta.sma(kK, kdjSmoothD)
    [ef, es, r, a, sk, va, adxv, kK, kD, close, open, high, low, volume]

[emaFast, emaSlow, rsi, atr, stochK, volAvg, adxVal, kdjK, kdjD, lClose, lOpen, lHigh, lLow, lVolume] =
     request.security(syminfo.tickerid, timeframe.period, decisionBundle(), lookahead=barmerge.lookahead_off)

volFilter = lVolume > volAvg * volume_threshold
isVolatile = (atr / lClose) > volThreshold
entryVolumeConfirm = lVolume > volAvg * entryVolumeMultiplier

// ---- 大周期 EMA（只保留4H+日线；补充lookahead=barmerge.lookahead_off，避免高周期未收盘bar被提前看到） ----
emaFast_4H  = request.security(syminfo.tickerid, "240", ta.ema(close, emaFastLen), lookahead=barmerge.lookahead_off)
emaSlow_4H  = request.security(syminfo.tickerid, "240", ta.ema(close, emaSlowLen), lookahead=barmerge.lookahead_off)
emaFast_1D  = request.security(syminfo.tickerid, "D", ta.ema(close, emaFastLen), lookahead=barmerge.lookahead_off)
emaSlow_1D  = request.security(syminfo.tickerid, "D", ta.ema(close, emaSlowLen), lookahead=barmerge.lookahead_off)

// ---- KDJ 过滤（用于打分，KDJ数值已在decisionBundle里锁定） ----
kdj_filter_long  = use_kdj_filter ? (stochK > 50) : true
kdj_filter_short = use_kdj_filter ? (stochK < 50) : true
volume_filter = use_volume_filter ? volFilter : true

// ---- 综合打分（本版只做4H+日线：移除了本地图表EMA点和12H点，满分从9降到7） ----
bullScore = 0
if use_4H_trend and emaFast_4H > emaSlow_4H
    bullScore := bullScore + 1
if use_1D_trend and emaFast_1D > emaSlow_1D
    bullScore := bullScore + 1
if rsi > 55
    bullScore := bullScore + 1
if stochK > 55
    bullScore := bullScore + 1
if isVolatile
    bullScore := bullScore + 1
if volume_filter
    bullScore := bullScore + 1
if kdj_filter_long
    bullScore := bullScore + 1

bearScore = 0
if use_4H_trend and emaFast_4H < emaSlow_4H
    bearScore := bearScore + 1
if use_1D_trend and emaFast_1D < emaSlow_1D
    bearScore := bearScore + 1
if rsi < 45
    bearScore := bearScore + 1
if stochK < 45
    bearScore := bearScore + 1
if isVolatile
    bearScore := bearScore + 1
if volume_filter
    bearScore := bearScore + 1
if kdj_filter_short
    bearScore := bearScore + 1

volumeGateRequired_long  = bullScore < (longEntryScore + scoreMarginForSkipVolume)
volumeGateRequired_short = bearScore < (shortEntryScore + scoreMarginForSkipVolume)

// ---- 【新增】次级确认票数：isVolatile/量能/KDJ 三项各算一票，独立于评分池，专职做质量把关 ----
qualityVotes_long  = (isVolatile ? 1 : 0) + (volume_filter ? 1 : 0) + (kdj_filter_long ? 1 : 0)
qualityVotes_short = (isVolatile ? 1 : 0) + (volume_filter ? 1 : 0) + (kdj_filter_short ? 1 : 0)
qualityGateOK_long  = not useQualityGate or qualityVotes_long  >= minQualityVotes
qualityGateOK_short = not useQualityGate or qualityVotes_short >= minQualityVotes

// ---- 【新增】评分新鲜度：本bar评分刚好达标，上一bar尚未达标，视为新鲜突破（独立于评分门槛本身，只用于豁免放量确认） ----
freshBullCross = bullScore >= longEntryScore and bullScore[1] < longEntryScore
freshBearCross = bearScore >= shortEntryScore and bearScore[1] < shortEntryScore

// ---- 真正的KDJ指标状态（K/D交叉体系，用于反转确认；kdjK/kdjD已在decisionBundle里锁定，此处只做状态判断） ----
kdjBearishState = kdjK < kdjD
kdjBullishState = kdjK > kdjD

// ---- 4H级别裸K实体强度 + 放量判断（未改动） ----
[h4_open, h4_high, h4_low, h4_close, h4_volume, h4_volAvg] = request.security(syminfo.tickerid, "240",
     [open[1], high[1], low[1], close[1], volume[1], ta.sma(volume, 20)[1]], lookahead=barmerge.lookahead_off)

h4_range = h4_high - h4_low
h4_body = math.abs(h4_close - h4_open)
h4_bodyRatio = h4_body / math.max(h4_range, syminfo.mintick)
h4_isDecisiveBear = h4_close < h4_open and h4_bodyRatio >= candleBodyRatio
h4_isDecisiveBull = h4_close > h4_open and h4_bodyRatio >= candleBodyRatio
h4_isHighVolume = h4_volume > h4_volAvg * candleVolMultiplier
h4_bearReversal = h4_isDecisiveBear and h4_isHighVolume
h4_bullReversal = h4_isDecisiveBull and h4_isHighVolume

// ---- 动态风控（未改动） ----
var float dayStartEquity = na
if ta.change(time("D")) or na(dayStartEquity)
    dayStartEquity := strategy.equity
dailySafe = ((dayStartEquity - strategy.equity) / dayStartEquity * 100) < maxDailyLossPercent

var float peakEquity = 0.0
peakEquity := math.max(peakEquity, strategy.equity)
currentDD = (peakEquity - strategy.equity) / peakEquity * 100
riskMult = currentDD > 14 ? 0.2 : (currentDD > 10 ? 0.5 : (currentDD > 6 ? 0.8 : 1.0))
sharpeEst = ta.sma(rsi, 14) / math.max(ta.stdev(rsi, 14), 0.001)
finalRisk = math.min(baseRiskPercent * sharpeEst * riskMult, 3.5)
sizingCapitalBase = useFixedCapitalBase ? math.min(fixedCapitalBase, math.max(strategy.equity, 0)) : strategy.equity
riskAmount = sizingCapitalBase * finalRisk / 100

calcQty(stop) =>
    dist = math.max(math.abs(lClose - stop), syminfo.mintick)
    rawQty = riskAmount / dist
    maxAllowedQtyByLeverage = (sizingCapitalBase * maxLeverage) / lClose
    maxAllowedQtyByNotional = maxNotionalCap / lClose
    math.max(math.floor(math.min(math.min(rawQty, maxAllowedQtyByLeverage), maxAllowedQtyByNotional)), 1)

// ---- 主动止损上移 ----
var float activeStop = na
var int current_tier = 1

// ---- 【新增】加仓生命周期状态：记录首次入场的档位/K线位置/仓位数量，用于加仓资格判断；持仓归零时重置 ----
var int entryTier = na
var int entryBarIndex = na
var float entryQty = na
var bool hasAddedOnce = false

tierLabel(t) =>
    t == 0 ? "弱" : t == 2 ? "强" : "中"

// ---- 反转确认持续性计数（本版bullScore/bearScore已不含本地EMA点，无需再减去） ----
exitBullScore = bullScore
exitBearScore = bearScore

// ---- 【新增】评分骤降检测：单根K线评分环比骤降，独立于quickExitConfirmBars的连续确认要求 ----
bullScoreCrash = (exitBullScore[1] - exitBullScore) >= scoreCrashThreshold
bearScoreCrash = (exitBearScore[1] - exitBearScore) >= scoreCrashThreshold

var int bearStreak = 0
var int bullStreak = 0
bearStreak := exitBearScore >= quickExitScore ? bearStreak + 1 : 0
bullStreak := exitBullScore >= quickExitScore ? bullStreak + 1 : 0

var int consecBearCandles = 0
var int consecBullCandles = 0
consecBearCandles := lClose < lOpen ? consecBearCandles + 1 : 0
consecBullCandles := lClose > lOpen ? consecBullCandles + 1 : 0

consecAdverseLongExit  = useConsecAdverseExit and strategy.position_size > 0 and consecBearCandles >= consecAdverseBars
consecAdverseShortExit = useConsecAdverseExit and strategy.position_size < 0 and consecBullCandles >= consecAdverseBars

entryCandleRange = lHigh - lLow
entryCandleBody = math.abs(lClose - lOpen)
entryBodyRatio = entryCandleBody / math.max(entryCandleRange, syminfo.mintick)
entryCandleBullConfirm = lClose > lOpen and entryBodyRatio >= entryCandleBodyRatio
entryCandleBearConfirm = lClose < lOpen and entryBodyRatio >= entryCandleBodyRatio

// ======================== 统一警报出口的状态变量 ========================
entryFired = false
entryPayload = ""
closeFired = false
closePayload = ""

// ---- 【新增】持仓归零时重置加仓生命周期状态 ----
if strategy.position_size == 0
    entryTier := na
    entryBarIndex := na
    entryQty := na
    hasAddedOnce := false

// ======================== 【修改】平开独立不互斥防闪烁锁 ========================
// 开仓锁：独立控制开仓/加仓，每K线最多发一次开仓类警报（LONG/SHORT/ADD_LONG/ADD_SHORT共用）
// 平仓锁：独立控制平仓，每K线最多发一次平仓警报
var int entryLockBar = na
var int closeLockBar = na

if barstate.isnew
    entryLockBar := na
    closeLockBar := na

// ======================== 【修改】入场条件 + 加仓条件（盘中提前 + 收盘保底，共用开仓锁） ========================
// 基础入场条件（原逻辑）
longBase  = (bullScore >= longEntryScore) and (lClose > emaSlow_4H) and (not useEntryVolumeConfirm or not volumeGateRequired_long or entryVolumeConfirm or (useFreshSignalBoost and freshBullCross)) and inTimeRange and dailySafe and strategy.position_size <= 0 and (not useEntryCandleConfirm or entryCandleBullConfirm) and qualityGateOK_long
shortBase = (bearScore >= shortEntryScore) and (lClose < emaSlow_4H) and (not useEntryVolumeConfirm or not volumeGateRequired_short or entryVolumeConfirm or (useFreshSignalBoost and freshBearCross)) and inTimeRange and dailySafe and strategy.position_size >= 0 and (not useEntryCandleConfirm or entryCandleBearConfirm) and qualityGateOK_short

entryCanFire = na(entryLockBar) or entryLockBar != bar_index   // 开仓锁：本K线未发过开仓警报

// 盘中提前入场（仅实时K线有效，回测自动跳过）
earlyLong = useEarlyEntry and barstate.isrealtime and longBase and (lClose - lOpen) > atr * earlyBodyThreshold
earlyShort = useEarlyEntry and barstate.isrealtime and shortBase and (lOpen - lClose) > atr * earlyBodyThreshold

// 收盘入场（原逻辑保底，同样受开仓锁控制）
closeLong = barstate.isconfirmed and longBase and entryCanFire
closeShort = barstate.isconfirmed and shortBase and entryCanFire

finalLong = earlyLong or closeLong
finalShort = earlyShort or closeShort

// ---- 加仓条件（同样拆分为盘中提前 + 收盘保底，受开仓锁控制） ----
liveTier = adxVal >= adxStrongThreshold ? 2 : (adxVal < adxWeakThreshold ? 0 : 1)

addOnLongBase  = useAddOnEntry and strategy.position_size > 0 and not hasAddedOnce and not na(entryTier) and entryTier == 2 and liveTier == 2 and not na(entryBarIndex) and (bar_index - entryBarIndex) >= addOnMinBarsGap and (lClose - strategy.position_avg_price) >= atr * addOnMinProfitATRMult and bullScore >= (longEntryScore + addOnScoreMargin) and lClose > emaSlow_4H and inTimeRange and dailySafe
addOnShortBase = useAddOnEntry and strategy.position_size < 0 and not hasAddedOnce and not na(entryTier) and entryTier == 2 and liveTier == 2 and not na(entryBarIndex) and (bar_index - entryBarIndex) >= addOnMinBarsGap and (strategy.position_avg_price - lClose) >= atr * addOnMinProfitATRMult and bearScore >= (shortEntryScore + addOnScoreMargin) and lClose < emaSlow_4H and inTimeRange and dailySafe

addOnEarlyLong = useEarlyEntry and barstate.isrealtime and addOnLongBase and (lClose - lOpen) > atr * earlyBodyThreshold
addOnEarlyShort = useEarlyEntry and barstate.isrealtime and addOnShortBase and (lOpen - lClose) > atr * earlyBodyThreshold
addOnCloseLong = barstate.isconfirmed and addOnLongBase and entryCanFire
addOnCloseShort = barstate.isconfirmed and addOnShortBase and entryCanFire

finalAddLong = addOnEarlyLong or addOnCloseLong
finalAddShort = addOnEarlyShort or addOnCloseShort

// ---- 执行开多 ----
if (finalLong)
    entryLockBar := bar_index   // 🔒 上开仓锁
    current_tier := adxVal >= adxStrongThreshold ? 2 : (adxVal < adxWeakThreshold ? 0 : 1)
    slMult = (current_tier == 0 ? weakSLMult : current_tier == 2 ? strongSLMult : midSLMult) * globalSLMultiplier
    tp1Mult = current_tier == 0 ? weakTP1Mult : current_tier == 2 ? strongTP1Mult : midTP1Mult
    tp2Mult = current_tier == 0 ? weakTP2Mult : current_tier == 2 ? strongTP2Mult : midTP2Mult
    tp3Mult = current_tier == 0 ? weakTP3Mult : current_tier == 2 ? strongTP3Mult : midTP3Mult
    qty = calcQty(lClose - atr * slMult)
    sl = lClose - atr * slMult
    strategy.entry("多", strategy.long, qty=qty, comment="开多")
    activeStop := sl
    entryTier := current_tier
    entryBarIndex := bar_index
    entryQty := qty
    entryPayload := "{" + "\"secret\":\"" + secret + "\",\"action\":\"LONG\",\"symbol\":\"" + syminfo.ticker + "\",\"price\":" + str.tostring(lClose) + ",\"atr\":" + str.tostring(atr) + ",\"stop_loss\":" + str.tostring(sl) + ",\"tp1\":" + str.tostring(lClose + atr*tp1Mult) + ",\"tp2\":" + str.tostring(lClose + atr*tp2Mult) + ",\"tp3\":" + str.tostring(lClose + atr*tp3Mult) + ",\"tier\":" + str.tostring(current_tier) + ",\"tier_label\":\"" + tierLabel(current_tier) + "\",\"bot_id\":\"" + bot_id + "\"}"
    entryFired := true

// ---- 执行开空 ----
if (finalShort)
    entryLockBar := bar_index
    current_tier := adxVal >= adxStrongThreshold ? 2 : (adxVal < adxWeakThreshold ? 0 : 1)
    slMultS = (current_tier == 0 ? weakSLMult : current_tier == 2 ? strongSLMult : midSLMult) * globalSLMultiplier
    tp1MultS = current_tier == 0 ? weakTP1Mult : current_tier == 2 ? strongTP1Mult : midTP1Mult
    tp2MultS = current_tier == 0 ? weakTP2Mult : current_tier == 2 ? strongTP2Mult : midTP2Mult
    tp3MultS = current_tier == 0 ? weakTP3Mult : current_tier == 2 ? strongTP3Mult : midTP3Mult
    qty = calcQty(lClose + atr * slMultS)
    sl = lClose + atr * slMultS
    strategy.entry("空", strategy.short, qty=qty, comment="开空")
    activeStop := sl
    entryTier := current_tier
    entryBarIndex := bar_index
    entryQty := qty
    entryPayload := "{" + "\"secret\":\"" + secret + "\",\"action\":\"SHORT\",\"symbol\":\"" + syminfo.ticker + "\",\"price\":" + str.tostring(lClose) + ",\"atr\":" + str.tostring(atr) + ",\"stop_loss\":" + str.tostring(sl) + ",\"tp1\":" + str.tostring(lClose - atr*tp1MultS) + ",\"tp2\":" + str.tostring(lClose - atr*tp2MultS) + ",\"tp3\":" + str.tostring(lClose - atr*tp3MultS) + ",\"tier\":" + str.tostring(current_tier) + ",\"tier_label\":\"" + tierLabel(current_tier) + "\",\"bot_id\":\"" + bot_id + "\"}"
    entryFired := true

// ---- 执行加仓多 ----
if (finalAddLong)
    entryLockBar := bar_index
    addOnQty = math.max(math.floor(entryQty * addOnSizeRatio), 1)
    strategy.entry("多", strategy.long, qty=addOnQty, comment="加仓多")
    hasAddedOnce := true
    entryPayload := "{" + "\"secret\":\"" + secret + "\",\"action\":\"ADD_LONG\",\"symbol\":\"" + syminfo.ticker + "\",\"price\":" + str.tostring(lClose) + ",\"atr\":" + str.tostring(atr) + ",\"stop_loss\":" + str.tostring(activeStop) + ",\"tier\":" + str.tostring(liveTier) + ",\"tier_label\":\"" + tierLabel(liveTier) + "\",\"bot_id\":\"" + bot_id + "\"}"
    entryFired := true

// ---- 执行加仓空 ----
if (finalAddShort)
    entryLockBar := bar_index
    addOnQty = math.max(math.floor(entryQty * addOnSizeRatio), 1)
    strategy.entry("空", strategy.short, qty=addOnQty, comment="加仓空")
    hasAddedOnce := true
    entryPayload := "{" + "\"secret\":\"" + secret + "\",\"action\":\"ADD_SHORT\",\"symbol\":\"" + syminfo.ticker + "\",\"price\":" + str.tostring(lClose) + ",\"atr\":" + str.tostring(atr) + ",\"stop_loss\":" + str.tostring(activeStop) + ",\"tier\":" + str.tostring(liveTier) + ",\"tier_label\":\"" + tierLabel(liveTier) + "\",\"bot_id\":\"" + bot_id + "\"}"
    entryFired := true

tierSLMult  = (current_tier == 0 ? weakSLMult  : current_tier == 2 ? strongSLMult  : midSLMult) * globalSLMultiplier
tierTP1Mult = current_tier == 0 ? weakTP1Mult : current_tier == 2 ? strongTP1Mult : midTP1Mult
tierTP2Mult = current_tier == 0 ? weakTP2Mult : current_tier == 2 ? strongTP2Mult : midTP2Mult
tierTP3Mult = current_tier == 0 ? weakTP3Mult : current_tier == 2 ? strongTP3Mult : midTP3Mult
tp1Dist = atr * tierTP1Mult

// ======================== 【修改】快速平仓（去掉barstate.isconfirmed，用独立平仓锁） ========================
scoreExitLongTrigger  = bearStreak >= quickExitConfirmBars and (not useKDJExitConfirm or kdjBearishState)
scoreExitShortTrigger = bullStreak >= quickExitConfirmBars and (not useKDJExitConfirm or kdjBullishState)

baseExitLongTrigger  = exitModeSelect == "4H裸K+量能主导(完全取代评分)" ? h4_bearReversal : exitModeSelect == "混合(评分OR 4H，任一满足即出)" ? (scoreExitLongTrigger or h4_bearReversal) : scoreExitLongTrigger
baseExitShortTrigger = exitModeSelect == "4H裸K+量能主导(完全取代评分)" ? h4_bullReversal : exitModeSelect == "混合(评分OR 4H，任一满足即出)" ? (scoreExitShortTrigger or h4_bullReversal) : scoreExitShortTrigger

exitLongTrigger  = baseExitLongTrigger or consecAdverseLongExit or (useScoreCrashExit and bullScoreCrash)
exitShortTrigger = baseExitShortTrigger or consecAdverseShortExit or (useScoreCrashExit and bearScoreCrash)

exitLongReasonText  = (useScoreCrashExit and bullScoreCrash and not baseExitLongTrigger and not consecAdverseLongExit) ? "评分骤降" : consecAdverseLongExit and not baseExitLongTrigger   ? "连续逆势K线" : h4_bearReversal and not scoreExitLongTrigger  ? "4H裸K放量反转" : "评分反转"
exitShortReasonText = (useScoreCrashExit and bearScoreCrash and not baseExitShortTrigger and not consecAdverseShortExit) ? "评分骤降" : consecAdverseShortExit and not baseExitShortTrigger ? "连续逆势K线" : h4_bullReversal and not scoreExitShortTrigger ? "4H裸K放量反转" : "评分反转"

closeCanFire = na(closeLockBar) or closeLockBar != bar_index   // 平仓锁：本K线未发过平仓警报

// 快速平多（盘中实时触发）
if (strategy.position_size > 0 and exitLongTrigger and closeCanFire)
    closeLockBar := bar_index
    strategy.close("多", comment="快速平多")
    closePayload := "{" + "\"secret\":\"" + secret + "\",\"action\":\"CLOSE_QUICK_EXIT\",\"symbol\":\"" + syminfo.ticker + "\",\"side\":\"LONG\",\"price\":" + str.tostring(lClose) + ",\"reason\":\"" + exitLongReasonText + "\",\"bot_id\":\"" + bot_id + "\"}"
    closeFired := true

// 快速平空
if (strategy.position_size < 0 and exitShortTrigger and closeCanFire)
    closeLockBar := bar_index
    strategy.close("空", comment="快速平空")
    closePayload := "{" + "\"secret\":\"" + secret + "\",\"action\":\"CLOSE_QUICK_EXIT\",\"symbol\":\"" + syminfo.ticker + "\",\"side\":\"SHORT\",\"price\":" + str.tostring(lClose) + ",\"reason\":\"" + exitShortReasonText + "\",\"bot_id\":\"" + bot_id + "\"}"
    closeFired := true

// ======================== 【修改】RSI 反转平仓（盘中实时触发，独立平仓锁） ========================
if (strategy.position_size < 0 and rsi > rsiExitLevel and rsi[1] <= rsiExitLevel and closeCanFire)
    closeLockBar := bar_index
    strategy.close("空", comment="RSI平空")
    closePayload := "{" + "\"secret\":\"" + secret + "\",\"action\":\"CLOSE_RSI_EXIT\",\"symbol\":\"" + syminfo.ticker + "\",\"side\":\"SHORT\",\"price\":" + str.tostring(lClose) + ",\"reason\":\"RSI超卖反弹\",\"bot_id\":\"" + bot_id + "\"}"
    closeFired := true

if (strategy.position_size > 0 and rsi < (100 - rsiExitLevel) and rsi[1] >= (100 - rsiExitLevel) and closeCanFire)
    closeLockBar := bar_index
    strategy.close("多", comment="RSI平多")
    closePayload := "{" + "\"secret\":\"" + secret + "\",\"action\":\"CLOSE_RSI_EXIT\",\"symbol\":\"" + syminfo.ticker + "\",\"side\":\"LONG\",\"price\":" + str.tostring(lClose) + ",\"reason\":\"RSI超买回落\",\"bot_id\":\"" + bot_id + "\"}"
    closeFired := true

// ======================== 关于TP1/TP2/TP3/止损/保本止损：明确不发webhook ========================
// strategy.exit()里的limit(止盈)、stop(止损，含保本移动止损activeStop)都是TV自己内部模拟账本的结算，
// 和VPS真实持仓的止损/止盈是两套完全独立的机制（VPS用实际成交价×1.15算硬止损、TP1/TP2是独立真实限价单、
// TP3之后交给雷达按ATR跟踪，触发价格和时机不会和TV这边的模拟值对齐）。
// 曾经尝试过在这里加一道"仓位缩小即发CLOSE_AUTO_FILL"的兜底检测，同步TV自己的止损/保本止损/TP成交，
// 但这类消息无法区分具体是TP1/TP2/TP3/止损/保本止损中的哪一种，且会让TV内部的保本移动止损
// 和VPS自己的"提前保本检查点"变成两套并行的保本逻辑，与既定架构标准冲突，已明确移除，不再保留。
// VPS开仓时已用entryPayload里的tp1/tp2/tp3/stop_loss/atr/tier字段独立挂好止盈止损和雷达，
// 全程不需要TV再通知，TV这边TP/止损自动成交完全不产生webhook。

// ======================== 【修改】统一警报出口（改为实时发送，freq_once_per_bar） ========================
// 三段式判断：平仓和开仓同时触发则合并数组发送，否则单独发送
if closeFired and entryFired
    alert("[" + closePayload + "," + entryPayload + "]", alert.freq_once_per_bar)
else if closeFired
    alert(closePayload, alert.freq_once_per_bar)
else if entryFired
    alert(entryPayload, alert.freq_once_per_bar)

// ======================== 保本移动止损（修复：改用独立的beTriggerATRMult，不再依赖被拉宽的tp1Dist） ========================
if (strategy.position_size > 0 and high >= strategy.position_avg_price + atr * beTriggerATRMult)
    activeStop := math.max(activeStop, strategy.position_avg_price + syminfo.mintick * 8)

if (strategy.position_size < 0 and low <= strategy.position_avg_price - atr * beTriggerATRMult)
    activeStop := math.min(activeStop, strategy.position_avg_price - syminfo.mintick * 8)

// ======================== 动态追踪参数（未改动） ========================
trailFactor = trailTight * (adxVal > 25 ? 0.85 : 1.1)

// ======================== 分批止盈（qty_percent 10/20/70，未改动） ========================
strategy.exit("TP1", qty_percent=tp1Pct, 
     limit = strategy.position_avg_price + (strategy.position_size > 0 ? atr*tierTP1Mult : -atr*tierTP1Mult),
     stop = activeStop, comment="TP1", comment_loss="止损")

strategy.exit("TP2", qty_percent=tp2Pct, 
     limit = strategy.position_avg_price + (strategy.position_size > 0 ? atr*tierTP2Mult : -atr*tierTP2Mult),
     stop = activeStop, 
     trail_points = atr * trailFactor * 0.7, 
     trail_offset = atr * trailFactor * 0.35, 
     comment="TP2", comment_loss="止损", comment_trailing="TP2")

strategy.exit("TP3", qty_percent=100 - tp1Pct - tp2Pct, 
     stop = activeStop, 
     trail_points = atr * trailFactor * 1.1, 
     trail_offset = atr * trailFactor * 0.5, 
     comment="TP3", comment_loss="止损", comment_trailing="TP3")

// ======================== 绘图（未改动） ========================
plot(emaFast, "快线 EMA", color=color.blue, linewidth=2)
plot(emaSlow, "慢线 EMA", color=color.orange, linewidth=2)
plot(strategy.position_size != 0 ? activeStop : na, "止损线", color=color.yellow, linewidth=2, style=plot.style_linebr)

var label tierLabelPlot = na
if barstate.islast
    label.delete(tierLabelPlot)
    modeText = useQualityGate ? ("质量门槛≥" + str.tostring(minQualityVotes)) : "v7.0原版"
    addOnText = hasAddedOnce ? " | 已加仓" : ""
    tierLabelPlot := label.new(bar_index, high, "当前档位: " + tierLabel(current_tier) + " | " + modeText + addOnText, style=label.style_label_down, color=color.new(color.blue, 20), textcolor=color.white, size=size.normal)