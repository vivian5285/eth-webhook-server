[Unit]
Description=Gate EMA hedge-cycle paper arena (no real orders)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stratroster
Group=stratroster
WorkingDirectory=/home/stratroster/eth-webhook-server
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/stratroster/eth-webhook-server/venv/bin/python -m strategy_engine.hedge_cycle.runner
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
