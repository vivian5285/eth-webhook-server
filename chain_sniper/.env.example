# ============================================================
# chain_sniper 配置。复制为 .env 并填入真实值——.env 已被仓库根目录
# .gitignore 的裸 `.env` 规则覆盖（任意深度生效），不会被提交。
# ============================================================

# 模式：DRY_RUN=true 时只记录"本该做什么"，不会真的下单，不会花一分钱。
# 必须先完成空跑验证阶段，才允许改成 false（见 README 的验证流程）。
DRY_RUN=true

# ---- 链 RPC ----
BSC_RPC_URL=
SOLANA_RPC_URL=
HELIUS_API_KEY=
# BSC 聪明钱触发用的免费公共节点（逗号分隔，依次轮换/兜底）。留空用内置默认
# (publicnode / llamarpc / bnbchain / drpc)。
BSC_RPC_URLS=
BSC_POLL_INTERVAL_SEC=60
BSC_MAX_BLOCKS_PER_POLL=300
# BscScan/Etherscan-V2 免费 key（可选，即时申请，无需信用卡）。设了 BSC 聪明钱
# 就走干净的逐钱包 account/tokentx 轮询；不设则 keyless 扫块兜底（慢、易被限流）。
BSCSCAN_API_KEY=
JUPITER_API_URL=https://quote-api.jup.ag/v6
USE_JITO_BUNDLES=true
JITO_BLOCK_ENGINE_URL=

# ---- 钱包活动追踪 ----
# Moralis：免费额度 2026-09 已停用，不再依赖（BSC 触发改走 keyless BSC RPC 轮询）
MORALIS_API_KEY=
# Birdeye：免费 30K CU/月，SOL+BSC。发现器 v2 的 top_traders/gainers-losers/
# new_listing/trader-txs 都靠它（bds.birdeye.so 注册）
BIRDEYE_API_KEY=

# ---- 安全过滤 ----
GOPLUS_API_KEY=
GOPLUS_APP_SECRET=

# ---- 热钱包私钥 —— 只放 VPS 环境变量，绝不提交 git，绝不出现在日志/Telegram ----
BSC_HOT_WALLET_PRIVATE_KEY=
SOLANA_HOT_WALLET_PRIVATE_KEY=

# ---- 风控层（代码硬约束）----
MAX_POSITION_SIZE_USD=25
DAILY_LOSS_CAP_USD=100
MAX_CONCURRENT_POSITIONS=3
TOKEN_COOLDOWN_SEC=3600
KILL_SWITCH_AUTO_RESET_DAILY=true

# ---- 轮询节流（2026-09-04：Helius 免费额度扛不住高频轮询，避免 429 刷屏）----
SIGNAL_LOOP_INTERVAL_SEC=45     # 信号主循环间隔（原来写死 15s）
WALLET_POLL_INTERVAL_SEC=90     # 同一个钱包两次轮询的最小间隔（错峰）
WALLET_POLL_GAP_SEC=1.2         # 轮询相邻两个钱包之间的 sleep

# ---- 聪明钱自动发现（discovery/wallet_finder.py，无需 API key，GeckoTerminal）----
DISCOVERY_CHAINS=solana,bsc
DISCOVERY_SCORE_MIN=45          # 发现结果里 score >= 此值的才灌进监控名单
DISCOVERY_MIN_RUNNER_MULT=5     # "跑出来的票" = 30 天内最高涨幅 >= 5x
DISCOVERY_MIN_RUNNER_HITS=2     # 一个钱包要在 >=2 个不同 runner 里买过才算数（交叉验证）
DISCOVERY_MIN_POOL_LIQ_USD=12000
DISCOVERY_MAX_POOL_AGE_DAYS=45
DISCOVERY_MAX_PER_CHAIN=40
DISCOVERY_MAX_TOTAL_WALLETS=160

# ---- 信号阈值 ----
MIN_SMART_WALLET_BUYS=1
SM_WINDOW_SEC=300
REQUIRED_CONFIRMATIONS=3
MIN_UNIQUE_BUYERS_5MIN=10
MAX_TOP10_HOLDER_PCT=50
MAX_BUY_TAX_PCT=10
MAX_SELL_TAX_PCT=10
REQUIRE_LP_LOCKED=true
REJECT_IF_MINT_AUTHORITY_ACTIVE=true
REJECT_IF_HONEYPOT=true

# ---- 离场管理 ----
EXIT_POLL_INTERVAL_SEC=4
TP_PCT=0.30
SL_PCT=0.15

# ---- 真相账本 / 复盘（每个信号后追踪该币真实价格轨迹，走 keyless DexScreener）----
OUTCOME_POLL_SEC=600            # 追踪循环间隔（10 分钟）
OUTCOME_TRACK_HOURS=36          # 每条信号追踪多久
OUTCOME_RUG_LIQ_FRAC=0.15      # 流动性跌到信号时刻的 15% 以下判 rug

# ---- 模拟成交折价（不加则总结出来的收益偏乐观）----
SIM_LATENCY_SLIP_PCT=0.015     # 延迟滑点（确认后跟单本来就慢）
SIM_SIZE_SLIP_K=0.5            # 体量滑点系数（仓位相对池子流动性）
SIM_MAX_SLIP_PCT=0.06         # 单边滑点封顶
SIM_MAX_HOLD_HOURS=24         # 最长持仓，到点按现价市价出

# ---- Telegram（复用主程序 VPS 上现在唯一在用的通知渠道，变量名故意与根目录 .env 一致）----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_RETRY_MAX=3
TELEGRAM_RETRY_SEC=3
HEARTBEAT_INTERVAL_HOURS=4
CHAINSNIPER_LABEL=链上狙击
