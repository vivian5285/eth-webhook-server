# ============================================================
# polymarket_quant 配置。复制为 .env 并填入真实值——.env 已被仓库根目录
# .gitignore 的裸 `.env` 规则覆盖（任意深度生效），不会被提交。
# ============================================================

# 模式：DRY_RUN=true 时只记录"本该做什么"，不会真的下单，不会花一分钱。
# 必须先完成空跑验证阶段，才允许改成 false（见 README 的验证流程）。
DRY_RUN=true

# ---- Polymarket CLOB ----
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://ws-live-data.polymarket.com
CHAIN_ID=137
SIGNATURE_TYPE=1

# 专用Polygon热钱包 —— 只放VPS环境变量，绝不提交git，绝不出现在日志/Telegram。
# 不要和 chain_sniper 的 BSC/Solana 热钱包共用，资金要隔离。
POLYGON_WALLET_PRIVATE_KEY=
POLYGON_FUNDER_ADDRESS=

# ---- 策略范围 ----
SYMBOLS=BTC
WINDOW_MINUTES=5

# ---- 信号阈值 ----
MIN_EDGE_BEFORE_FEES_PCT=0.05
MIN_EDGE_AFTER_FEES_PCT=0.02
MAKER_TIME_BUFFER_SEC=120
EARLY_EXIT_EDGE_REVERSAL_PCT=0.05
FEED_STALE_TIMEOUT_SEC=15

# ---- 风控层（代码硬约束）----
MAX_STAKE_PER_WINDOW_USD=10
DAILY_LOSS_CAP_USD=50
MAX_CONCURRENT_WINDOWS=1
MAX_TRADES_PER_HOUR=6
MAX_TRADES_PER_DAY=50
KILL_SWITCH_AUTO_RESET_DAILY=true

# ---- Telegram（复用主程序VPS上现在唯一在用的通知渠道，变量名故意与根目录 .env 一致）----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_RETRY_MAX=3
TELEGRAM_RETRY_SEC=3
HEARTBEAT_INTERVAL_HOURS=4
POLYMARKET_LABEL=Poly量化
