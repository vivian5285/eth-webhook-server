# Copy to .env on VPS (never commit real secrets)

WEBHOOK_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Console 管理页 http://IP:5003/console （务必改掉默认口令）
CONSOLE_PASSWORD=binance-console
CONSOLE_SESSION_SECRET=

DINGTALK_WEBHOOK=
DINGTALK_SECRET=
WECHAT_WEBHOOK=

# Telegram — all events (Level 1 + Level 2)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_RETRY_MAX=3
TELEGRAM_RETRY_SEC=3

# 盯盘品种（逗号分隔，含 BNB 则填 BNBUSDT；未填则默认 ETHUSDT,XAUUSDT）
BINANCE_SYMBOLS=ETHUSDT,XAUUSDT,BNBUSDT

# Brand label in TG titles (distinguish from 双子星量化 etc.)
NOTIFY_SYSTEM_NAME=币安单系统

# Telegram — primary notify channel (all events Level 1 + Level 2); DingTalk deprecated
