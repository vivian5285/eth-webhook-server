# ── vwap_live 真账户测试 .env ──
# 两道闸门都打开才会真的下单：BINANCE_API_KEY/SECRET 非空 + LIVE_TRADING=true。
# 缺一个都只是观察模式(记账+发通知，不碰交易所)。
#
# ⚠️ 强烈建议：单独开一个新的币安子账户/API key，只给"合约交易"权限，
# 不给提现权限——跟 B/C/D/E 现有的真实雷达引擎账户完全隔离，出事只影响
# 这一个小额测试账户。

LIVE_TRADING=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://fapi.binance.com

# 只跑擂台里持续跑赢的一批(2026-09-12 数据)。若这个账户还有别的程序在
# 跑，注意跟它的品种池不要重叠——两套独立程序不能共享同一个品种，否则
# 保证金/杠杆设置会互相干扰。
SYMBOLS=GSUSDT,ETHUSDT,PAXGUSDT,UNIUSDT,XMRUSDT,BCHUSDT,LITEUSDT,BTCUSDT,OPENAIUSDT,SOLUSDT
TIMEFRAME=15m
LOOP_CHECK_SEC=300

# ── 风控（低杠杆原则：LEVERAGE 代码里硬顶 3x[测试阶段]，改这里也超不过）──
LEVERAGE=3
# 2026-09-12：改成"本金百分比"仓位管理(照抄这台VPS上真实TV币安引擎的
# RISK20 思路)——每次开仓前实时查账户余额，margin = 权益×POSITION_SIZE_PCT，
# 不再是固定美元数。
POSITION_SIZE_PCT=0.06
# 组合总敞口上限：账户全部持仓名义总值 ≤ 权益×这个倍数(照抄真实引擎的
# check_total_notional_cap，但给得比那边的18x保守很多——这套刚接真钱，
# 没有track record)。均值回归容易同一时刻好几个品种一起触发，这道专门
# 防"单笔都不大、一起开总敞口失控"。
MAX_TOTAL_NOTIONAL_MULT=2.0
# 纯观察(没接真实账户)时用来算示例仓位大小，不影响真实下单
FALLBACK_EQUITY_USD=200
MAX_CONCURRENT=5
DAILY_LOSS_LIMIT_USD=30
MAX_HOLD_HOURS=48

# ── vwap_mean_reversion 原版参数(2026-09-12 min_session_bars=24 修复后)──
N_STD=2.0
EXIT_BAND=0.3
MIN_SESSION_BARS=24
ADX_LEN=14
ADX_MAX=25.0
ATR_LEN=14
ATR_STOP_MULT=1.5
# 2026-09-12新增：经济性门槛——PAXGUSDT实盘复现过止损止盈距离比手续费
# 成本还窄(黄金/代币化股票波动率天生比加密货币低)，哪怕方向判对也赚不
# 够付手续费。信号理论最大盈利/止损距离两者都必须≥ROUND_TRIP_FEE_PCT×
# MIN_EDGE_OVER_FEE_MULT，覆盖不了就跳过不开仓(不是拉黑品种，按当天
# 实时波动判断)。0.10%是用binanceC真实成交commission核对过的双边费率。
ROUND_TRIP_FEE_PCT=0.10
MIN_EDGE_OVER_FEE_MULT=3.0

# ── 通知（留空则只写日志）──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LABEL=VWAP真账户测试
