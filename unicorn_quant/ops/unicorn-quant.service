# /etc/systemd/system/unicorn-quant.service
[Unit]
Description=Unicorn Quant platform (charts + backtest + paper trading)
After=network-online.target
[Service]
User=stratroster
WorkingDirectory=/home/stratroster/unicorn_quant
EnvironmentFile=/etc/unicorn-quant.env
ExecStart=/home/stratroster/eth-webhook-server/venv/bin/gunicorn -w 2 --threads 4 --timeout 90 --keep-alive 75 -b 127.0.0.1:18890 server:app
Restart=always
RestartSec=5
# 后台扫描子进程(sweep*.py)不随服务重启被杀
KillMode=process
[Install]
WantedBy=multi-user.target
